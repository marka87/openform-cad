{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenForm CAD",
  "version": "../package.json",
  "identifier": "org.openform.cad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenForm CAD",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "ofc"
        ],
        "name": "OpenForm-Modell",
        "description": "OpenForm CAD Modell",
        "role": "Editor",
        "mimeType": "application/x-openform"
      }
    ]
  }
}
